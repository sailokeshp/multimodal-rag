# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=local
API_PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=multimodal_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Storage ───────────────────────────────────────────────────────────────────
# Local dev: files are stored on disk under LOCAL_STORAGE_PATH.
# Production: set S3_BUCKET and AWS credentials.
LOCAL_STORAGE_PATH=/tmp/rag_uploads
S3_BUCKET=multimodal-rag-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Text embeddings ───────────────────────────────────────────────────────────
# Default: BAAI/bge-small-en-v1.5 (384d, fast CPU, ~33 MB)
# Alternatives:
#   BAAI/bge-base-en-v1.5   → set TEXT_EMBED_DIM=768
#   BAAI/bge-large-en-v1.5  → set TEXT_EMBED_DIM=1024
# WARNING: changing the model requires recreating the Postgres tables.
TEXT_EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
TEXT_EMBED_DIM=384
ENABLE_TEXT_EMBEDDINGS=true

# ── Image embeddings ──────────────────────────────────────────────────────────
# SigLIP2 so400m produces 1152-d vectors. Requires transformers + torch.
IMAGE_EMBED_MODEL_NAME=google/siglip2-so400m-patch16-384
IMAGE_EMBED_DIM=1152
# Disabled by default because the optional dependencies are not installed in
# the default worker image and the model is too heavy for small EC2 instances.
ENABLE_IMAGE_EMBEDDINGS=false
# Query-time policy:
#   image_only -> only image-style queries load SigLIP2 in the API
#   always     -> every query also searches the image vector space
IMAGE_QUERY_EMBED_POLICY=image_only

# ── Generation ────────────────────────────────────────────────────────────────
# Backend options:
#   "google_ai" — Gemini Flash via Google AI free API (1,500 req/day, no credit card) ← DEFAULT
#   "groq"      — Groq-hosted model, if you have an active supported model configured
#   "local"     — HuggingFace model on local machine (~4 GB RAM, NOT for t2.micro)
GEN_MODEL_BACKEND=google_ai
GEN_MODEL_NAME=gemma2-9b-it

# --- Groq backend (default) ---
# Free key at: https://console.groq.com  (no credit card required)
GROQ_API_KEY=

# --- Google AI backend (alternative) ---
# Free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# --- Local HuggingFace backend ---
# GEN_MODEL_BACKEND=local
# GEN_MODEL_NAME=google/gemma-2-2b-it  # requires ~4.5 GB RAM
# GEN_MAX_TOKENS=512

ENABLE_GROUNDED_ANSWER=true

# ── OCR ───────────────────────────────────────────────────────────────────────
USE_LOCAL_OCR=true
USE_TEXTRACT=false
# Requires: brew install tesseract  or  apt-get install tesseract-ocr

# ── Retrieval tuning ──────────────────────────────────────────────────────────
TOP_K_TEXT=8
TOP_K_IMAGE=8
TOP_K_FINAL=10
# Minimum cosine similarity to include a result (0.0 disables threshold)
RETRIEVAL_SCORE_THRESHOLD=0.3

# ── Cross-encoder reranking ───────────────────────────────────────────────────
# Reranking runs a cross-encoder on the top-N bi-encoder candidates and
# re-scores them with much higher precision. Recommended for document Q&A.
# Latency cost: ~50-200ms extra on CPU for 10-30 candidates.
ENABLE_RERANKING=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Fetch this many times more candidates than top_k before reranking.
RERANK_FETCH_MULTIPLIER=3

# ── Document diversity filter ─────────────────────────────────────────────────
# Maximum results returned from any single source document.
# Prevents one large document from filling all top-K slots.
# Set to 0 to disable. Recommended: 3 for 10+ document use cases.
DIVERSITY_MAX_PER_FILE=3

# ── Answer generation ─────────────────────────────────────────────────────────
# Max tokens of document context passed to the LLM (~4 chars/token).
# 3000 tokens ≈ 12,000 chars — enough for ~10 dense paragraphs.
# Increase for larger documents; decrease if you hit LLM context limits.
MAX_CONTEXT_TOKENS=3000

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300

# ── Queue (optional — leave empty for local inline ingestion) ─────────────────
SQS_QUEUE_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# Set a non-empty value to require X-API-Key header on all requests.
API_KEY=
